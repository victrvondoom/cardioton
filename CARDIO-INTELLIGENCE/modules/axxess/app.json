{
  "expo": {
    "name": "medscribe",
    "slug": "medscribe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "medscribe",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4A0E1A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medscribe.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/axxess__assets_images__adaptive-icon.png",
        "backgroundColor": "#8B1A2E"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.medscribe.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "MedScribe needs microphone access to record clinical sessions.",
          "speechRecognitionPermission": "MedScribe uses speech recognition for real-time transcription."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}